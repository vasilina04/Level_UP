DATABASE_URL="postgresql://levelup:levelup-local@127.0.0.1:5432/levelup?schema=public"
AUTH_SECRET=""
AUTH_TRUST_HOST=true
APP_TIMEZONE="Asia/Vladivostok"
# 1 при доверенном прокси, который сам устанавливает X-Real-IP
TRUST_PROXY_IP=0
# 1 только для локального тестирования production-сборки по HTTP
AUTH_LOCAL_HTTP=0
# Установите 1 перед загрузкой вымышленных аккаунтов
ENABLE_DEMO_SEED=0
